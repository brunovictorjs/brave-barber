# ── Servidor ──────────────────────────────────────────────────────────────
PORT=3333
# Origem do front-end (CORS e links nos e-mails)
WEB_URL=http://localhost:3000
NODE_ENV=development
TZ=America/Recife
# Fuso da barbearia: todos os horários de agenda são calculados nele
BUSINESS_TIMEZONE=America/Recife

# ── Banco de dados ────────────────────────────────────────────────────────
# Desenvolvimento: SQLite (arquivo local, criado em prisma/sqlite/dev.db)
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# Produção (Supabase): troque o provedor e use as duas URLs do projeto.
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ── Autenticação ──────────────────────────────────────────────────────────
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d
# Login com Google (opcional em desenvolvimento). Sem ele, a tela de login
# oferece "Entrar como" com os usuários do seed.
GOOGLE_CLIENT_ID=
# Liga o login de desenvolvimento. Nunca deixe true em produção.
DEV_LOGIN=true

# ── Pagamentos ────────────────────────────────────────────────────────────
# Sem STRIPE_SECRET_KEY o sistema usa um gateway simulado (Pix e cartão de teste).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Arquivos (fotos de serviços e produtos) ───────────────────────────────
# local: grava em apps/api/uploads · supabase: grava no Supabase Storage
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# ── E-mail ────────────────────────────────────────────────────────────────
# log: só registra os envios no console e em "Últimos envios" (nada sai de verdade)
# resend: envio real pelo Resend (https://resend.com)
MAIL_DRIVER=log
RESEND_API_KEY=
# Remetente. Sem domínio verificado no Resend, use onboarding@resend.dev
# (só entrega para o e-mail da conta Resend). Em produção: Brave Barber <contato@seudominio.com.br>
MAIL_FROM=Brave Barber <onboarding@resend.dev>
# Resposta do cliente vai para cá (vazio = e-mail público da casa)
MAIL_REPLY_TO=
# Fora de produção é obrigatório com MAIL_DRIVER=resend: TODOS os e-mails vão para este endereço
MAIL_REDIRECT_TO=
