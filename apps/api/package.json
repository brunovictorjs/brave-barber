{
  "name": "@brave-barber/api",
  "version": "1.0.0",
  "private": true,
  "description": "API da Brave Barber — NestJS em monólito modular (DDD + Clean Architecture)",
  "scripts": {
    "prisma:schema": "node scripts/prisma-schema.mjs",
    "prisma": "node scripts/prisma.mjs",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:seed": "ts-node -r tsconfig-paths/register --transpile-only prisma/seed.ts",
    "db:setup": "node scripts/prisma.mjs migrate dev --name init --skip-seed && npm run db:seed",
    "db:reset": "node scripts/prisma.mjs migrate reset --force --skip-seed && npm run db:seed",
    "postinstall": "node scripts/prisma.mjs generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/serve-static": "5.0.3",
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "2.57.4",
    "cookie-parser": "1.4.7",
    "google-auth-library": "10.3.0",
    "multer": "2.0.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "18.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.6",
    "dotenv": "17.2.2",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testMatch": [
      "**/*.spec.ts"
    ],
    "transform": {
      "^.+[.]ts$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              "TS151001"
            ]
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testEnvironment": "node"
  }
}
